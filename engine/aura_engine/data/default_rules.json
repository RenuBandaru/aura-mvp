{
  "version": 4,
  "mig3": true,
  "mig6": true,
  "ucTypes": [
    {
      "id": "vendor",
      "label": "Using a vendor product or feature"
    },
    {
      "id": "build",
      "label": "Building something internally (including agents and automations)"
    },
    {
      "id": "model",
      "label": "Building or training a model"
    },
    {
      "id": "use",
      "label": "Using an AI tool to analyze, write or research"
    }
  ],
  "questions": [
    {
      "id": "q_us",
      "text": "Does it send company data outside the U.S.?",
      "short": "Data leaves the U.S.",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true
    },
    {
      "id": "q_enc",
      "text": "Is any of the data stored or sent unencrypted?",
      "short": "Unencrypted data",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true
    },
    {
      "id": "q_hall",
      "text": "Could the AI produce wrong, invented or biased values that people rely on?",
      "short": "Wrong or biased outputs possible",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true
    },
    {
      "id": "q_train",
      "text": "Is company data used to train models outside the company?",
      "short": "Data used to train outside models",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true
    },
    {
      "id": "q_ot",
      "text": "Can it change how plant equipment or products behave in ways that affect safety?",
      "short": "Changes safety-affecting behavior",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true
    },
    {
      "id": "q_pii",
      "text": "Does it use personal data (PII) such as for customers or employees?",
      "short": "Uses personally-identifiable data",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true
    },
    {
      "id": "q_ip",
      "text": "Does it expose product designs or other proprietary information?",
      "short": "Exposes proprietary information",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true
    },
    {
      "id": "q_people",
      "text": "Does it influence decisions about people?",
      "short": "Influences decisions about people",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true
    },
    {
      "id": "q_listed",
      "text": "Is the AI tool on the company's approved AI tool list?",
      "short": "On approved tool list",
      "type": "single",
      "options": [
        {
          "id": "listed",
          "label": "Yes, it is listed"
        },
        {
          "id": "pending",
          "label": "Not yet listed, a request is in progress"
        },
        {
          "id": "no",
          "label": "No"
        }
      ],
      "allowUnknown": true,
      "enabled": true
    },
    {
      "id": "q_svc",
      "text": "Which kind of AI service would be used?",
      "short": "Kind of AI service",
      "type": "single",
      "options": [
        {
          "id": "co",
          "label": "A company-approved AI service"
        },
        {
          "id": "pub",
          "label": "A public AI service"
        },
        {
          "id": "pers",
          "label": "A personal AI account"
        },
        {
          "id": "na",
          "label": "No outside AI service (it runs inside company systems)"
        }
      ],
      "allowUnknown": true,
      "enabled": true
    },
    {
      "id": "q_sens",
      "text": "What is the most sensitive information the AI will see or that people will enter?",
      "short": "Most sensitive information",
      "type": "single",
      "options": [
        {
          "id": "pub",
          "label": "Public or non-sensitive information only"
        },
        {
          "id": "int",
          "label": "Internal business information"
        },
        {
          "id": "conf",
          "label": "Confidential or proprietary information"
        },
        {
          "id": "pers",
          "label": "Personal or regulated data"
        }
      ],
      "allowUnknown": true,
      "enabled": true
    },
    {
      "id": "q_share",
      "text": "Will it share company, customer, employee or partner data with another company?",
      "short": "Data shared with another company",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true
    },
    {
      "id": "q_repo",
      "text": "Will any personal (non-company) AI account be connected to company code repositories?",
      "short": "Personal AI accounts on code repositories",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true
    },
    {
      "id": "q_code",
      "text": "Where will any AI-written or AI-assisted code, scripts or tests be used? For tests, choose what is being tested.",
      "short": "Where AI-written code or tests are used",
      "type": "single",
      "options": [
        {
          "id": "none",
          "label": "No AI-written code or tests"
        },
        {
          "id": "personal",
          "label": "Personal or team scripts"
        },
        {
          "id": "internal",
          "label": "Internal business systems"
        },
        {
          "id": "customer",
          "label": "Customer-facing software"
        },
        {
          "id": "firmware",
          "label": "Product or plant firmware"
        }
      ],
      "allowUnknown": true,
      "enabled": true,
      "showWhen": [
        {
          "src": "type",
          "in": [
            "build",
            "model",
            "use"
          ]
        }
      ]
    },
    {
      "id": "q_fw",
      "text": "Will the AI write, change or test firmware or embedded code that affects safety?",
      "short": "AI writes or tests safety-affecting firmware",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true,
      "showWhen": [
        {
          "src": "q:q_code",
          "in": [
            "firmware",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "q_target",
      "text": "What does it act on?",
      "short": "What it acts on",
      "type": "single",
      "options": [
        {
          "id": "plant",
          "label": "Plant equipment or products"
        },
        {
          "id": "it",
          "label": "IT systems"
        },
        {
          "id": "records",
          "label": "Customer or financial records"
        },
        {
          "id": "na",
          "label": "None of these"
        }
      ],
      "allowUnknown": true,
      "enabled": true,
      "showWhen": [
        {
          "src": "autonomy",
          "in": [
            "automate"
          ]
        }
      ]
    },
    {
      "id": "q_model",
      "text": "Is an AI model central to how this works?",
      "short": "AI model is central",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true,
      "showWhen": [
        {
          "src": "type",
          "in": [
            "vendor",
            "build",
            "use"
          ]
        }
      ]
    },
    {
      "id": "q_outside",
      "text": "Does it read content from outside sources (such as web pages, outside emails or documents), or can people outside the company type to it?",
      "short": "Reads outside content or takes outside input",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true,
      "showWhen": [
        {
          "any": [
            {
              "src": "type",
              "in": [
                "model"
              ]
            },
            {
              "src": "q:q_model",
              "in": [
                "yes",
                "unknown"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "q_tools",
      "text": "Can it use tools, connectors or credentials to take actions (for example send messages, change records or run code)?",
      "short": "Uses tools, connectors or credentials",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true,
      "showWhen": [
        {
          "any": [
            {
              "src": "type",
              "in": [
                "model"
              ]
            },
            {
              "src": "q:q_model",
              "in": [
                "yes",
                "unknown"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "q_access",
      "text": "How much company data can it reach?",
      "short": "Data access scope",
      "type": "single",
      "options": [
        {
          "id": "lim",
          "label": "Only the specific rows or datasets it needs"
        },
        {
          "id": "sys",
          "label": "Whole datasets or systems"
        },
        {
          "id": "broad",
          "label": "Broad access across several internal data stores"
        }
      ],
      "allowUnknown": true,
      "enabled": true
    },
    {
      "id": "q_pub",
      "text": "Will it produce content that is published or used outside the company, including translations?",
      "short": "Produces content used outside the company",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true
    },
    {
      "id": "q_rec",
      "text": "Does it record, transcribe or keep conversations, meetings or personnel data?",
      "short": "Records or keeps conversations or personnel data",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true
    },
    {
      "id": "q_patent",
      "text": "Does it touch inventions or patent material?",
      "short": "Touches inventions or patents",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true,
      "showWhen": [
        {
          "src": "q:q_ip",
          "in": [
            "yes",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "q_trainpii",
      "text": "Is personal data used to train or tune the model?",
      "short": "Personal data used to train or tune",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true,
      "showWhen": [
        {
          "src": "type",
          "in": [
            "model"
          ]
        }
      ]
    },
    {
      "id": "q_decide",
      "text": "Will its outputs be used for decisions with significant financial or operational consequences (for example contract, regulatory or technical specification review)?",
      "short": "Outputs drive consequential decisions",
      "type": "yesno",
      "allowUnknown": true,
      "enabled": true
    }
  ],
  "rules": [
    {
      "id": "g_enc",
      "kind": "guardrail",
      "ref": "BR-67",
      "label": "Unencrypted data",
      "message": "Data must be encrypted in storage and in transit before this can proceed.",
      "enabled": true,
      "when": [
        {
          "src": "q:q_enc",
          "in": [
            "yes",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "g_train",
      "kind": "guardrail",
      "ref": "BR-02",
      "label": "Data used to train outside models",
      "message": "Company data cannot be used to train models outside the company. Use a service that does not train on your data, or remove the data.",
      "enabled": true,
      "when": [
        {
          "src": "q:q_train",
          "in": [
            "yes",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "g_br01",
      "kind": "guardrail",
      "ref": "BR-01",
      "label": "Sensitive information with a public or personal AI service",
      "message": "Confidential, personal or unknown-sensitivity information cannot go to a public or personal AI service. Use a company-approved service or remove the information.",
      "enabled": true,
      "when": [
        {
          "src": "q:q_sens",
          "in": [
            "conf",
            "pers",
            "unknown"
          ]
        },
        {
          "src": "q:q_svc",
          "in": [
            "pub",
            "pers",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "g_br03",
      "kind": "guardrail",
      "ref": "BR-03",
      "label": "AI tool not on the approved list",
      "message": "Use only an AI tool on the company's approved list, or ask for the tool to be added. (This question stands in until the AI tool catalog exists.)",
      "enabled": true,
      "when": [
        {
          "src": "q:q_listed",
          "in": [
            "no",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "g_br04",
      "kind": "guardrail",
      "ref": "BR-04",
      "label": "Personal AI accounts on code repositories",
      "message": "Disconnect personal AI accounts from company code repositories, or use a company account.",
      "enabled": true,
      "when": [
        {
          "src": "q:q_repo",
          "in": [
            "yes",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "k_br03",
      "kind": "condition",
      "ref": "BR-03",
      "label": "Add the tool to the approved list",
      "message": "The tool must be added to the approved AI tool list before pilot.",
      "clearBy": "pilot",
      "enabled": true,
      "when": [
        {
          "src": "q:q_listed",
          "in": [
            "pending"
          ]
        }
      ]
    },
    {
      "id": "rq_ot",
      "kind": "require",
      "ref": "BR-06",
      "label": "Can change safety-affecting behavior of equipment or products",
      "control": "c_bounds",
      "level": "required",
      "enabled": true,
      "when": [
        {
          "src": "q:q_ot",
          "in": [
            "yes",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "rq_fw",
      "kind": "require",
      "ref": "BR-07",
      "label": "AI writes, changes or tests firmware that affects safety",
      "control": "c_validate",
      "level": "required",
      "enabled": true,
      "when": [
        {
          "src": "q:q_fw",
          "in": [
            "yes",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "rq_target",
      "kind": "require",
      "ref": "BR-08",
      "label": "Acts on its own on systems, equipment or records",
      "control": "c_rollback",
      "level": "required",
      "enabled": true,
      "when": [
        {
          "src": "q:q_target",
          "in": [
            "plant",
            "it",
            "records",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "rq_auto_kill",
      "kind": "require",
      "ref": "BR-08",
      "label": "Acts on its own",
      "control": "c_kill",
      "level": "recommended",
      "enabled": true,
      "when": [
        {
          "src": "autonomy",
          "in": [
            "automate"
          ]
        }
      ]
    },
    {
      "id": "rq_auto_log",
      "kind": "require",
      "ref": "BR-08",
      "label": "Acts on its own",
      "control": "c_log",
      "level": "recommended",
      "enabled": true,
      "when": [
        {
          "src": "autonomy",
          "in": [
            "automate"
          ]
        }
      ]
    },
    {
      "id": "rq_auto_access",
      "kind": "require",
      "ref": "BR-08",
      "label": "Acts on its own",
      "control": "c_access",
      "level": "recommended",
      "enabled": true,
      "when": [
        {
          "src": "autonomy",
          "in": [
            "automate"
          ]
        }
      ]
    },
    {
      "id": "rq_cust",
      "kind": "require",
      "ref": "BR-09",
      "label": "Customer-facing",
      "control": "c_escalate",
      "level": "required",
      "enabled": true,
      "when": [
        {
          "src": "scope",
          "in": [
            "customer"
          ]
        }
      ]
    },
    {
      "id": "rq_share",
      "kind": "require",
      "ref": "BR-02",
      "label": "Shares data with another company",
      "control": "c_share",
      "level": "required",
      "enabled": true,
      "when": [
        {
          "src": "q:q_share",
          "in": [
            "yes",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "rq_human_code",
      "kind": "require",
      "ref": "BR-19",
      "label": "AI-written code or tests for customers or firmware",
      "control": "c_human",
      "level": "required",
      "enabled": true,
      "when": [
        {
          "src": "q:q_code",
          "in": [
            "customer",
            "firmware",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "rq_human_int",
      "kind": "require",
      "ref": "BR-19",
      "label": "AI-written code or tests for internal business systems",
      "control": "c_human",
      "level": "recommended",
      "enabled": true,
      "when": [
        {
          "src": "q:q_code",
          "in": [
            "internal"
          ]
        }
      ]
    },
    {
      "id": "rq_human_cust",
      "kind": "require",
      "ref": "BR-19",
      "label": "Customer-facing output",
      "control": "c_human",
      "level": "required",
      "enabled": true,
      "when": [
        {
          "src": "scope",
          "in": [
            "customer"
          ]
        }
      ]
    },
    {
      "id": "rq_doc_model",
      "kind": "require",
      "ref": "BR-24",
      "label": "Builds or trains a model",
      "control": "c_docs",
      "level": "required",
      "enabled": true,
      "when": [
        {
          "src": "type",
          "in": [
            "model"
          ]
        }
      ]
    },
    {
      "id": "rq_doc_central",
      "kind": "require",
      "ref": "BR-24",
      "label": "An AI model is central to how it works",
      "control": "c_docs",
      "level": "required",
      "enabled": true,
      "when": [
        {
          "src": "type",
          "in": [
            "vendor",
            "build",
            "use"
          ]
        },
        {
          "src": "q:q_model",
          "in": [
            "yes",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "rq_human_decide",
      "kind": "require",
      "ref": "BR-10",
      "label": "Outputs drive consequential decisions",
      "control": "c_human",
      "level": "required",
      "enabled": true,
      "when": [
        {
          "src": "q:q_decide",
          "in": [
            "yes",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "o_ot",
      "kind": "override",
      "ref": "BR-06",
      "label": "Changes safety-affecting behavior",
      "minTier": "high",
      "enabled": true,
      "when": [
        {
          "src": "q:q_ot",
          "in": [
            "yes"
          ]
        }
      ]
    },
    {
      "id": "o_people",
      "kind": "override",
      "label": "Influences decisions about people",
      "minTier": "high",
      "enabled": true,
      "when": [
        {
          "src": "q:q_people",
          "in": [
            "yes"
          ]
        }
      ]
    },
    {
      "id": "o_customer",
      "kind": "override",
      "label": "Customer-facing",
      "minTier": "moderate",
      "enabled": true,
      "when": [
        {
          "src": "scope",
          "in": [
            "customer"
          ]
        }
      ]
    },
    {
      "id": "o_auto",
      "kind": "override",
      "label": "Acts without a person in the loop",
      "minTier": "moderate",
      "enabled": true,
      "when": [
        {
          "src": "autonomy",
          "in": [
            "automate"
          ]
        }
      ]
    },
    {
      "id": "pt_us",
      "kind": "points",
      "label": "Data leaves the U.S.",
      "points": 2,
      "enabled": true,
      "when": [
        {
          "src": "q:q_us",
          "in": [
            "yes",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "pt_enc",
      "kind": "points",
      "label": "Unencrypted data",
      "points": 3,
      "enabled": true,
      "when": [
        {
          "src": "q:q_enc",
