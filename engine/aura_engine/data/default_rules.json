          ]
        }
      ]
    },
    {
      "id": "pt_ip",
      "kind": "points",
      "label": "Exposes proprietary information",
      "points": 3,
      "enabled": true,
      "when": [
        {
          "src": "q:q_ip",
          "in": [
            "yes",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "pt_people",
      "kind": "points",
      "label": "Influences decisions about people",
      "points": 3,
      "enabled": true,
      "when": [
        {
          "src": "q:q_people",
          "in": [
            "yes",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "pt_decide",
      "kind": "points",
      "label": "Outputs drive consequential decisions",
      "points": 2,
      "enabled": true,
      "when": [
        {
          "src": "q:q_decide",
          "in": [
            "yes",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "pt_access_broad",
      "kind": "points",
      "ref": "BR-14",
      "label": "Broad access across internal data stores",
      "points": 2,
      "enabled": true,
      "when": [
        {
          "src": "q:q_access",
          "in": [
            "broad",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "pt_access_sys",
      "kind": "points",
      "ref": "BR-14",
      "label": "Access to whole datasets or systems",
      "points": 1,
      "enabled": true,
      "when": [
        {
          "src": "q:q_access",
          "in": [
            "sys"
          ]
        }
      ]
    },
    {
      "id": "pt_pub",
      "kind": "points",
      "ref": "BR-26",
      "label": "Produces content used outside the company",
