      "points": 3,
      "enabled": true,
      "when": [
        {
          "src": "q:q_train",
          "in": [
            "yes",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "pt_ot",
      "kind": "points",
      "label": "Changes safety-affecting behavior",
      "points": 4,
      "enabled": true,
      "when": [
        {
          "src": "q:q_ot",
          "in": [
            "yes",
            "unknown"
          ]
        }
      ]
    },
    {
      "id": "pt_pii",
      "kind": "points",
